# Public application origin. Required in production to prevent Host-header-based OAuth redirects.
SITE_URL=http://127.0.0.1:3000

# Safe for browser use when Row Level Security and explicit grants are enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_or_hosted_publishable_key

# Server only. Prefer a hosted sb_secret_ key; local development may use SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# Used only by the local Supabase Auth provider. Register
# http://localhost:54321/auth/v1/callback in the GitHub OAuth App.
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_SECRET=replace_with_github_oauth_client_secret
